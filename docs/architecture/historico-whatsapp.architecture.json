{
  "schema_version": 1,
  "diagram_type": "architecture",
  "meta": { "title": "Histórico do WhatsApp", "subtitle": "O passado do aparelho entra como contexto, nunca como evento", "output": "historico-whatsapp.html", "quality_profile": "standard" },
  "lanes": [
    { "id": "canal", "label": "WhatsApp / WAHA" },
    { "id": "servidor", "label": "Servidor" },
    { "id": "banco", "label": "Persistência" },
    { "id": "operador", "label": "Operação" }
  ],
  "mainPath": ["sessao", "pedido", "evento", "importador", "funcao", "mensagens", "inbox"],
  "nodes": [
    { "id": "sessao", "lane": "canal", "col": 1, "type": "external", "label": "createSession com noweb.store + fullSync; pareamento entrega o passado ao store" },
    { "id": "pedido", "lane": "servidor", "col": 2, "type": "lib", "label": "handleSessionStatus WORKING → pedirImportacaoDoHistorico (uma vez por sessão)" },
    { "id": "evento", "lane": "banco", "col": 3, "type": "database", "label": "event_log / whatsapp.history_import_requested" },
    { "id": "importador", "lane": "servidor", "col": 4, "type": "service", "label": "importar-historico-worker → executarRodadaDoHistorico (rodadas de 40s, retry sem gastar tentativa)" },
    { "id": "rest", "lane": "canal", "col": 4, "type": "external", "label": "REST chats/overview e chats/{id}/messages (sem mídia, janela de 90 dias)" },
    { "id": "funcao", "lane": "banco", "col": 5, "type": "database", "label": "fn_importar_historico_whatsapp (deduplica por external_id; só service_role)" },
    { "id": "mensagens", "lane": "banco", "col": 5, "type": "database", "label": "messages.is_historical / conversations sem não-lida e sem last_inbound_at" },
    { "id": "estado", "lane": "banco", "col": 3, "type": "database", "label": "channel_sessions.metadata.historico (estado, ponto de retomada, contagem)" },
    { "id": "inbox", "lane": "operador", "col": 6, "type": "frontend", "label": "Inbox: histórico lido pela equipe; aviso de mídia não importada" },
    { "id": "card", "lane": "operador", "col": 6, "type": "frontend", "label": "Conexões: andamento da importação no card do número" },
    { "id": "emissores", "lane": "banco", "col": 6, "type": "database", "label": "fn_emit_message_event e fn_emit_conversation_routing (ignoram a importação)" }
  ],
  "edges": [
    { "id": "e1", "from": "sessao", "to": "pedido", "label": "status WORKING" },
    { "id": "e2", "from": "pedido", "to": "estado", "label": "grava 'aguardando' com guarda de corrida" },
    { "id": "e3", "from": "pedido", "to": "evento", "label": "emite o pedido" },
    { "id": "e4", "from": "evento", "to": "importador", "label": "drain entrega" },
    { "id": "e5", "from": "importador", "to": "rest", "label": "lê conversas e mensagens" },
    { "id": "e6", "from": "importador", "to": "funcao", "label": "lote por contato" },
    { "id": "e7", "from": "funcao", "to": "mensagens", "label": "INSERT histórico" },
    { "id": "e8", "from": "importador", "to": "estado", "label": "grava onde parou" },
    { "id": "e9", "from": "mensagens", "to": "inbox", "label": "contexto para quem atende" },
    { "id": "e10", "from": "estado", "to": "card", "label": "metadata->historico" },
    { "id": "e11", "from": "mensagens", "to": "emissores", "label": "a importação NÃO emite (is_historical e marcador local)" }
  ],
  "notLinked": [
    { "from": "mensagens", "to": "IA / sentimento / follow-up / automações / roteamento", "why": "histórico é contexto: acioná-los responderia mensagens de meses atrás e distribuiria as conversas velhas entre os atendentes" }
  ]
}
